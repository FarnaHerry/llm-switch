{
  "templates": [
    {
      "name": "DeepSeek",
      "match": "api.deepseek.com",
      "url": "https://api.deepseek.com/user/balance",
      "path": "balance_infos.0.total_balance",
      "label": "CNY",
      "source": "https://api-docs.deepseek.com/api/get-user-balance"
    },
    {
      "name": "Kimi（Moonshot 国内站）",
      "match": "api.moonshot.cn",
      "url": "https://api.moonshot.cn/v1/users/me/balance",
      "path": "data.available_balance",
      "label": "CNY",
      "source": "https://platform.kimi.com/docs/api/balance"
    },
    {
      "name": "Kimi（Moonshot 国际站）",
      "match": "api.moonshot.ai",
      "url": "https://api.moonshot.ai/v1/users/me/balance",
      "path": "data.available_balance",
      "label": "USD",
      "source": "https://platform.kimi.ai/docs/api/balance"
    },
    {
      "name": "OpenRouter",
      "match": "openrouter.ai",
      "url": "https://openrouter.ai/api/v1/key",
      "path": "data.usage",
      "label": "USD 已用",
      "source": "https://openrouter.ai/docs/api/api-reference/api-keys/get-current-api-key"
    },
    {
      "name": "StepFun（阶跃国内站）",
      "match": "api.stepfun.com",
      "url": "https://api.stepfun.com/v1/accounts",
      "path": "balance",
      "label": "CNY",
      "source": "https://github.com/farion1231/cc-switch/blob/main/src-tauri/src/services/balance.rs"
    },
    {
      "name": "StepFun（阶跃国际站）",
      "match": "api.stepfun.ai",
      "url": "https://api.stepfun.ai/v1/accounts",
      "path": "balance",
      "label": "USD",
      "source": "https://github.com/farion1231/cc-switch/blob/main/src-tauri/src/services/balance.rs"
    },
    {
      "name": "SiliconFlow（国内站）",
      "match": "api.siliconflow.cn",
      "url": "https://api.siliconflow.cn/v1/user/info",
      "path": "data.totalBalance",
      "label": "CNY",
      "source": "https://github.com/farion1231/cc-switch/blob/main/src-tauri/src/services/balance.rs"
    },
    {
      "name": "SiliconFlow（国际站）",
      "match": "api.siliconflow.com",
      "url": "https://api.siliconflow.com/v1/user/info",
      "path": "data.totalBalance",
      "label": "USD",
      "source": "https://github.com/farion1231/cc-switch/blob/main/src-tauri/src/services/balance.rs"
    }
  ]
}
