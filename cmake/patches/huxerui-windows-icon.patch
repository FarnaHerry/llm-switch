+      if (icon != nullptr) {
+        DestroyIcon(icon);
+      }
+      if (small_icon != nullptr) {
+        DestroyIcon(small_icon);
+      }
+      throw std::runtime_error("HuxerUI could not load its Windows application icon resource");
+    }
+#endif
