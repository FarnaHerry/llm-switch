<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="llm-switch" Manufacturer="dev.farna.llmswitch" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
           UpgradeCode="@HUXERUI_WINDOWS_MSI_UPGRADE_CODE@" Scope="perMachine">
    <!-- afterInstallInitialize：旧版移除排在 InstallInitialize 之后、加入
         MSI 事务——升级失败可整体回滚，不会留下卸了旧版装不上新版的半成品。
         AllowSameVersionUpgrades 保持开启：同版本"重新安装"走干净的先卸后装
         （框架 SameVersion 维护页的主人路径）。 -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of llm-switch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ApplicationIcon" SourceFile="!(bindpath.Project)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="llm-switch" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMMENU" Name="llm-switch" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Application)\**" />
    </ComponentGroup>
    <Component Id="ApplicationShortcut" Directory="APPLICATIONPROGRAMMENU">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="llm-switch"
                Target="[INSTALLFOLDER]llm-switch.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RemoveFolder Id="RemoveApplicationProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.llmswitch\llm-switch" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationDesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="ApplicationDesktopShortcutLink" Name="llm-switch"
                Target="[INSTALLFOLDER]llm-switch.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.llmswitch\llm-switch" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Application" Title="llm-switch" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes">
      <Level Value="1" Condition="CREATE_DESKTOP_SHORTCUT = 1" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
