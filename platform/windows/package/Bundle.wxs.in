<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="llm-switch" Manufacturer="dev.farna.llmswitch" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
          UpgradeCode="@HUXERUI_WINDOWS_BUNDLE_UPGRADE_CODE@"
          IconSourceFile="!(bindpath.Project)\app.ico">
    <BootstrapperApplication SourceFile="!(bindpath.Installer)\llm-switch-Installer.exe">
      <PayloadGroupRef Id="HuxerUIInstallerPayloads" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]llm-switch" />
    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="0" />
    <Chain>
      <MsiPackage SourceFile="!(bindpath.Package)\llm-switch.msi">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
